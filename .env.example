# Copiar este archivo a .env.local y llenar los valores reales.
# Las llaves de Supabase (URL, anon key, service_role key) se comparten fuera
# del repo — ver README.md, sección "Levantar en local".

# Proyecto de Supabase: URL pública y llave anónima (safe para el navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave secreta de Supabase: salta RLS. Solo la usa app/api/proyectos/route.ts
# (Tarea 7.1), del lado del servidor y después de validar API_KEY_PROYECTOS.
# NUNCA lleva prefijo NEXT_PUBLIC_: con ese prefijo Next la mete en el bundle
# del navegador y queda pública.
# Dashboard de Supabase → Project Settings → API keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# API Route de solo lectura (Tarea 7.1.b) — llave fija para integraciones
# tipo n8n. Se manda en el header x-api-key. Cualquier valor propio sirve.
API_KEY_PROYECTOS=

# Chatbot RAG (Tarea 7.2). Opcional: la app sigue funcionando sin esta
# variable — el widget muestra un mensaje de configuración en vez de romper.
# OPENAI_API_KEY=

# Opcional. Si no se pone, app/api/chat/route.ts usa 'gpt-4o-mini'.
# OPENAI_MODEL=gpt-4o-mini
